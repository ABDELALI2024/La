# Langzio private config — OUTSIDE public_html (~/langzio-private/config.php)
# Copy .env.example values into private/config.php on the server. Never commit real secrets.

DB_HOST=localhost
DB_NAME=langzio
DB_USER=langzio_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

APP_ENV=production
APP_URL=https://langzio.com
APP_KEY=generate-32-byte-random-hex
SESSION_NAME=LANGZIOSESSID
COOKIE_SECURE=1

# AI (Gemini). Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_DAILY_FREE=20
AI_DAILY_PREMIUM=200

# Stripe (optional until live). Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Email (Hostinger SMTP or any SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@langzio.com
SMTP_PASS=
MAIL_FROM=no-reply@langzio.com

# Admin bootstrap (first admin created via seed or hPanel; remove after)
ADMIN_EMAIL=
